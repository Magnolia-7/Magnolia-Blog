APP_NAME=My Blog
DEBUG=False

DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/my_blog?charset=utf8mb4

SECRET_KEY=please_change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Local media storage
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_MB=10

# Cloudflare R2 (set STORAGE_DRIVER=r2 to enable)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=magnolia-blog-images
R2_PUBLIC_BASE_URL=https://img.magnolianook.com
