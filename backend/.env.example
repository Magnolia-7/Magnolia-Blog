APP_NAME=My Blog
DEBUG=False

DATABASE_URL=mysql+pymysql://username:password@127.0.0.1:3306/my_blog?charset=utf8mb4

SECRET_KEY=please_change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Media storage. Keep STORAGE_DRIVER=local for 2.0; switch the implementation
# to r2 later without changing article or album data.
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
MEDIA_BASE_URL=/media
MAX_UPLOAD_SIZE_MB=10
